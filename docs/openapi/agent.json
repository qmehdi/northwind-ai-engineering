      "type": "string"
     },
     "budget_usd": {
      "default": 0.1,
      "exclusiveMinimum": 0.0,
      "maximum": 5.0,
      "title": "Budget Usd",
      "type": "number"
     },
     "max_steps": {
      "default": 6,
      "maximum": 20.0,
      "minimum": 1.0,
      "title": "Max Steps",
      "type": "integer"
     },
