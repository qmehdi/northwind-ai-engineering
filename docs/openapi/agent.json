      "anyOf": [
       {
        "minimum": 1000.0,
        "type": "integer"
       },
       {
        "type": "null"
       }
      ],
      "title": "Max Total Tokens"
     },
     "subject": {
      "default": "",
      "title": "Subject",
      "type": "string"
     },
     "task": {
      "minLength": 3,
      "title": "Task",
      "type": "string"
     },
     "ticket_id": {
      "default": "T-000000",
      "pattern": "^T-\\d{6}$",
      "title": "Ticket Id",
      "type": "string"
     }
    },
    "required": [
     "task"
    ],
    "title": "RouteRequest",
    "type": "object"
   },
   "SpecialistRequest": {
    "properties": {
     "account_id": {
      "anyOf": [
       {
        "pattern": "^NW-\\d{5,}$",
        "type": "string"
       },
       {
        "type": "null"
       }
      ],
      "description": "The ticket's account; the run's customer tools read this account only",
      "title": "Account Id"
     },
     "budget_usd": {
      "default": 0.1,
      "exclusiveMinimum": 0.0,
      "maximum": 5.0,
      "title": "Budget Usd",
      "type": "number"
     },
     "max_steps": {
      "default": 6,
      "maximum": 20.0,
      "minimum": 1.0,
      "title": "Max Steps",
      "type": "integer"
     },
     "max_total_tokens": {
      "anyOf": [
       {
        "minimum": 1000.0,
        "type": "integer"
       },
       {
        "type": "null"
       }
      ],
      "title": "Max Total Tokens"
     },
     "task": {
      "minLength": 3,
      "title": "Task",
      "type": "string"
     }
    },
    "required": [
     "task"
    ],
    "title": "SpecialistRequest",
    "type": "object"
   },
   "SpecialistResponse": {
    "properties": {
     "cost_usd": {
      "title": "Cost Usd",
      "type": "number"
     },
     "final": {
      "anyOf": [
       {
        "type": "string"
       },
       {
        "type": "null"
       }
      ],
      "title": "Final"
     },
     "proposed_actions": {
      "items": {
       "additionalProperties": true,
       "type": "object"
      },
      "title": "Proposed Actions",
      "type": "array"
     },
     "run_id": {
      "title": "Run Id",
      "type": "string"
     },
     "steps": {
      "title": "Steps",
      "type": "integer"
     },
     "terminated": {
      "title": "Terminated",
      "type": "string"
     }
    },
    "required": [
     "run_id",
     "final",
     "terminated",
     "steps",
     "cost_usd",
     "proposed_actions"
    ],
    "title": "SpecialistResponse",
    "type": "object"
   },
   "ValidationError": {
    "properties": {
     "ctx": {
      "title": "Context",
      "type": "object"
     },
     "input": {
      "title": "Input"
     },
     "loc": {
      "items": {
       "anyOf": [
        {
         "type": "string"
        },
        {
         "type": "integer"
        }
       ]
      },
      "title": "Location",
      "type": "array"
     },
     "msg": {
      "title": "Message",
      "type": "string"
     },
     "type": {
      "title": "Error Type",
      "type": "string"
     }
    },
    "required": [
     "loc",
     "msg",
     "type"
    ],
    "title": "ValidationError",
    "type": "object"
   }
  }
