     }
    },
    "title": "PredictRequest",
    "type": "object"
   },
   "TicketIn": {
    "properties": {
     "body": {
      "maxLength": 20000,
      "minLength": 1,
      "title": "Body",
      "type": "string"
     },
     "subject": {
      "default": "",
      "maxLength": 500,
      "title": "Subject",
      "type": "string"
     },
     "ticket_id": {
      "anyOf": [
       {
        "pattern": "^T-\\d{6}$",
        "type": "string"
       },
       {
        "type": "null"
       }
      ],
      "title": "Ticket Id"
     }
    },
    "required": [
     "body"
    ],
    "title": "TicketIn",
    "type": "object"
   },
   "TriageResult": {
    "properties": {
     "confidence": {
      "title": "Confidence",
      "type": "number"
     },
     "model_version": {
      "title": "Model Version",
      "type": "string"
     },
     "priority": {
      "pattern": "^P[0-3]$",
      "title": "Priority",
      "type": "string"
     },
     "probabilities": {
      "additionalProperties": {
       "type": "number"
      },
      "title": "Probabilities",
      "type": "object"
     },
     "rule": {
      "title": "Rule",
      "type": "string"
     }
    },
    "required": [
     "priority",
     "probabilities",
     "confidence",
     "rule",
     "model_version"
    ],
    "title": "TriageResult",
    "type": "object"
   },
   "ValidationError": {
    "properties": {
     "ctx": {
      "title": "Context",
      "type": "object"
     },
     "input": {
      "title": "Input"
     },
     "loc": {
      "items": {
       "anyOf": [
        {
         "type": "string"
        },
        {
         "type": "integer"
        }
       ]
      },
      "title": "Location",
      "type": "array"
     },
     "msg": {
      "title": "Message",
      "type": "string"
     },
     "type": {
      "title": "Error Type",
      "type": "string"
     }
    },
    "required": [
     "loc",
     "msg",
     "type"
    ],
    "title": "ValidationError",
    "type": "object"
   }
  }
 },
