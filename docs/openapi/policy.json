{
 "components": {
  "schemas": {
   "Ask": {
    "properties": {
     "audience": {
      "default": "customer",
      "pattern": "^(customer|internal)$",
      "title": "Audience",
      "type": "string"
     },
     "k": {
      "default": 8,
      "maximum": 20.0,
      "minimum": 1.0,
      "title": "K",
      "type": "integer"
     },
     "question": {
      "maxLength": 2000,
      "minLength": 3,
      "title": "Question",
      "type": "string"
     }
    },
    "required": [
     "question"
    ],
    "title": "Ask",
    "type": "object"
   },
   "AskResponse": {
    "description": "An Answer plus what the service adds: an id to give feedback on, the model that\nanswered, and whether it came from the cache.",
    "properties": {
     "answer_id": {
      "title": "Answer Id",
      "type": "string"
     },
     "cached": {
      "default": false,
      "title": "Cached",
      "type": "boolean"
     },
     "citations": {
      "items": {
       "type": "string"
      },
      "title": "Citations",
      "type": "array"
     },
     "confidence": {
      "title": "Confidence",
      "type": "number"
     },
     "context_ids": {
      "items": {
       "type": "string"
      },
      "title": "Context Ids",
      "type": "array"
     },
     "dropped_citations": {
      "items": {
       "type": "string"
      },
      "title": "Dropped Citations",
      "type": "array"
     },
     "model_id": {
      "title": "Model Id",
      "type": "string"
     },
     "prompt_version": {
      "default": "",
      "title": "Prompt Version",
      "type": "string"
     },
     "reason": {
      "anyOf": [
       {
        "type": "string"
       },
       {
        "type": "null"
       }
      ],
      "title": "Reason"
     },
     "refused": {
      "title": "Refused",
      "type": "boolean"
     },
     "text": {
      "title": "Text",
      "type": "string"
     }
    },
    "required": [
     "text",
     "citations",
     "confidence",
     "refused",
     "context_ids",
     "answer_id",
     "model_id"
    ],
    "title": "AskResponse",
    "type": "object"
   },
   "FeedbackIn": {
    "properties": {
     "answer_id": {
      "maxLength": 64,
      "minLength": 8,
      "title": "Answer Id",
      "type": "string"
     },
     "note": {
      "default": "",
      "maxLength": 2000,
      "title": "Note",
      "type": "string"
     },
     "verdict": {
      "enum": [
       "helpful",
       "wrong",
       "unsafe"
      ],
      "title": "Verdict",
      "type": "string"
     }
    },
    "required": [
     "answer_id",
     "verdict"
    ],
    "title": "FeedbackIn",
    "type": "object"
   },
   "HTTPValidationError": {
    "properties": {
     "detail": {
      "items": {
       "$ref": "#/components/schemas/ValidationError"
      },
      "title": "Detail",
      "type": "array"
     }
    },
    "title": "HTTPValidationError",
    "type": "object"
   },
   "ValidationError": {
    "properties": {
     "ctx": {
      "title": "Context",
      "type": "object"
     },
     "input": {
      "title": "Input"
     },
     "loc": {
      "items": {
       "anyOf": [
        {
         "type": "string"
        },
        {
         "type": "integer"
        }
       ]
      },
      "title": "Location",
      "type": "array"
     },
     "msg": {
      "title": "Message",
      "type": "string"
     },
     "type": {
      "title": "Error Type",
      "type": "string"
     }
    },
    "required": [
     "loc",
     "msg",
     "type"
    ],
    "title": "ValidationError",
    "type": "object"
   }
  }
 },
 "info": {
  "title": "Northwind policy service",
  "version": "1.1"
 },
 "openapi": "3.1.0",
 "paths": {
  "/ask": {
   "post": {
    "deprecated": true,
    "description": "Deprecated alias of `/v1/ask`, kept for one release. Call `/v1/ask`.",
    "operationId": "ask_ask_post",
    "requestBody": {
     "content": {
      "application/json": {
       "schema": {
        "$ref": "#/components/schemas/Ask"
       }
      }
     },
     "required": true
    },
    "responses": {
     "200": {
      "content": {
       "application/json": {
        "schema": {
