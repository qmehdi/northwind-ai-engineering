# Copy to .env and fill in. Nothing here is read by tests; tests use the fake provider.
# Everything below the first block has a sensible default; uncomment to override.

# Track: aws | gcp | azure | local. "local" runs Workhorse and Economy on Ollama and needs no account.
NW_TRACK=local
# Provider: auto | fake. "fake" answers every role in memory (what the tests and the
# service-layer exercises use); "auto" routes by track and model id.
# NW_PROVIDER=auto

# Tenant and environment on a cohort platform; both travel on logs and cost records.
# NW_TENANT=
# NW_ENVIRONMENT=

# Model gateway (LiteLLM on the platform). When set, every role goes through it: the role's
# model id is the gateway model name, and the key is the tenant's virtual key (bearer).
# NW_GATEWAY_URL=
# NW_GATEWAY_KEY=

# AWS track
NW_AWS_REGION=us-east-1
NW_AWS_PROFILE=default

# AWS platform (from deploy/aws/outputs.json after make deploy-aws; the environment wins over the file)
# NW_ENV=                          # environment word after northwind for a second deploy of the stack
# NW_CONNECTION_ARN=               # CodeConnections ARN; without it the delivery pipeline is skipped
# NW_ALERT_EMAIL=                  # alarms, approvals and the budget
# NW_BUDGET_USD=200
# NW_LAKE_FORMATION=false
# NW_AWS_DATA_BUCKET=              # DataBucket output
# NW_AWS_ARTIFACTS_BUCKET=         # ArtifactsBucket output
# NW_AWS_SERVING_ROLE_ARN=         # ServingRoleArn output
# NW_AWS_RUNTIME_ROLE_ARN=         # RuntimeRoleArn output
# NW_AWS_REGISTRY_ID=              # RegistryId output (Agent Registry)
# NW_AWS_KNOWLEDGE_BASES=          # alice=KB1,live=KB2 (KnowledgeBases output)
# NW_KNOWLEDGE_BASE_ID=            # the live knowledge base, set on the deployed services
# NW_AWS_IMAGE_TRIAGE=             # SageMaker inference image for the registry (or tags["image"]); prebuilt scikit-learn 1.9, x86_64 (SDK image_uri_config, 2026-09-29):
#                                  #   683313688378.dkr.ecr.us-east-1.amazonaws.com/sagemaker-scikit-learn:1.9-0-cpu-py3
# NW_AWS_IMAGE_SEMANTIC=           # prebuilt PyTorch inference 2.6 CPU (onnxruntime from code/requirements.txt):
#                                  #   763104351884.dkr.ecr.us-east-1.amazonaws.com/pytorch-inference:2.6.0-cpu-py312-ubuntu22.04-sagemaker
# NW_AWS_DIRECT_DEPLOY=            # 1: EndpointClient.deploy creates the serverless endpoint itself (solo default)
# NW_AWS_PIPELINE_IMAGE=           # the nw-pipelines image in ECR (PipelineImage output; make images-aws pushes it without the delivery pipeline)
# NW_GATEWAY_KEY_SECRET_ARN=       # set on the deployed services instead of NW_GATEWAY_KEY; read once at startup
# NW_MEMORY_ID=                    # AgentCore Memory of the live resolver; /version reports it
# NW_AGENT_REGISTRY=               # the Agent Registry record the resolver runs under; /version reports it

# GCP track
NW_GCP_PROJECT=
NW_GCP_REGION=global
# NW_GCP_RUN_REGION=us-central1    # where the platform lives: Cloud Run, Pipelines, registry, Agent Engine
# NW_BILLING_ACCOUNT=              # 012345-6789AB-CDEF01, for the budget
# NW_GCP_PROJECT_NUMBER=           # looked up with gcloud when unset
# NW_ENVIRONMENT=northwind         # prefix of every platform name; a second value is a second environment
# NW_MODE=cohort                   # cohort | solo
# NW_TENANTS=                      # alice,bob in cohort mode
# NW_TENANT=                       # this learner's handle; solo when unset
# NW_GATEWAY_URL=                  # the LiteLLM gateway (terraform output gateway_url)
# NW_GATEWAY_KEY=                  # the tenant's virtual key (Secret Manager <environment>-<tenant>-gateway-key)
# NW_GCP_ARTIFACTS_BUCKET=         # default <environment>-<project>-artifacts
# NW_GCP_PIPELINES_BUCKET=         # default <environment>-<project>-pipelines
# NW_GCP_DATA_BUCKET=              # default <environment>-<project>-data; pipeline runs read tickets/tickets.jsonl from it
# NW_PIPELINE_DIR=artifacts/pipelines   # compiled Kubeflow YAML, one per pipeline name
# NW_GCP_SERVING_IMAGE=            # prebuilt serving container attached to registered versions
# NW_GCP_LIVE_MODELS=triage,semantic    # live endpoints, ids from NW_GCP_ENDPOINT_ID_BASE=100000
# NW_RAG_BACKEND=managed           # managed | vector_search (per node hour, see COSTS)
# NW_RAG_CORPUS=                   # the tenant's RAG Engine corpus, set on the deployed policy service (NW_RETRIEVER=rag-engine)
# NW_GATEWAY_KEY_SECRET_NAME=      # projects/<p>/secrets/<n>/versions/latest, read once at startup instead of NW_GATEWAY_KEY
# NW_GCP_SERVING_IMAGE=            # the course image built with --target serving answers the Vertex contract (AIP_HTTP_PORT, AIP_HEALTH_ROUTE, AIP_PREDICT_ROUTE)
# NW_GATEWAY_DATABASE=true         # Cloud SQL for per-tenant keys; false is master key only
# NW_GITHUB_OWNER= NW_GITHUB_APP_INSTALLATION_ID= NW_GITHUB_TOKEN_SECRET_VERSION=   # Cloud Build triggers
# NW_GCP_MAAS_REGION=us-central1   # the managed API for open models (gpt-oss); gpt-oss-20b is us-central1 only

# Local track
# NW_OLLAMA_URL=http://localhost:11434/v1
# NW_ANTHROPIC_API_KEY=            # turns the Judge from fake-judge into Claude through the Anthropic API

# Model roles. Leave blank to use the track defaults in nw/config.py (ADR 0010):
#   aws    gpt-oss-120b (openai.gpt-oss-120b-1:0), Opus 5 judge, Nova Micro (us.amazon.nova-micro-v1:0)
#   gcp    openai/gpt-oss-120b-maas, claude-opus-5 judge, openai/gpt-oss-20b-maas
#   local  gpt-oss:120b, fake-judge (claude-opus-5 with a cloud key), gpt-oss:20b
NW_MODEL_WORKHORSE=
NW_MODEL_JUDGE=
NW_MODEL_ECONOMY=
# NW_MODEL_STRANDS=            # Converse API id for the Strands port, if it differs

# Serving on a platform (ADR 0008). The platform injects these on a deployed service; a laptop leaves them unset.
# NW_MODEL_URI=                    # s3://, gs://, file:// or models:/ (MLflow) artifact of the version served, fetched into a temp dir at startup
#                                  # NW_TRIAGE_MODEL and NW_SEMANTIC_ARTIFACT stay the fallback; a Vertex endpoint's AIP_STORAGE_URI is honoured the same way
# NW_MODEL_VERSION=                # the registry version served; /version reports it (else the artifact's own version)
# NW_QDRANT_COLLECTION=           # Local track: the tenant's collection (default <environment>-<tenant>-policies)
# NW_RETRIEVER=inprocess           # policy service: inprocess | knowledge-base (NW_KNOWLEDGE_BASE_ID) | rag-engine (NW_RAG_CORPUS) | qdrant (NW_QDRANT_COLLECTION)
# NW_QDRANT_COLLECTION=            # Local track: the Qdrant collection the policy service searches
# AIP_HTTP_PORT=8080               # set by a Vertex endpoint; AIP_HEALTH_ROUTE=/health and AIP_PREDICT_ROUTE=/predict are the platform defaults

# Service layer
# NW_METRICS_EXPORT_S=60        # seconds between exported metric lines; 0 disables
# NW_METRICS_FORMAT=json        # json (Cloud Run log-based metrics) | emf (CloudWatch Embedded Metric Format)
# NW_STAGE=                     # dev | staging | prod: prefixes every deployed name; empty keeps the guide's names
# NW_IMAGE_TAG=                 # GCP image tag; default is the git SHA, -dirty with uncommitted changes
# NW_CANARY=0                   # GCP: first canary phase of the Cloud Deploy pipeline is canary_percent in deploy/gcp/platform
NW_MAX_CONCURRENCY=8
NW_SPEND_CAP_USD=10.0
NW_LOG_FORMAT=json
# NW_REQUEST_TIMEOUT_S=60         # enforced around every model call; a timeout is retryable
# NW_MODEL_FALLBACK_WORKHORSE=    # a second model for the role, tried once when the primary fails
# NW_MODEL_FALLBACK_JUDGE=
# NW_MODEL_FALLBACK_ECONOMY=
# NW_BREAKER_FAILURES=3           # consecutive failures that open a model's circuit
# NW_BREAKER_OPEN_S=30            # seconds the circuit stays open before one probe
# `python -m nw.config` prints every effective setting, its source and the config hash

# Auth: every deployed service requires x-api-key. Set one of these; probes stay open.
# NW_API_KEY=
# NW_API_KEY_SECRET_ARN=       # AWS Secrets Manager, read once at cold start
# NW_API_KEY_SECRET_NAME=      # projects/<p>/secrets/<n>/versions/latest on GCP
# NW_API_KEY may also be a JSON map of key id to secret; ids go on logs and metrics, secrets never do.
# NW_API_KEY={"cohort-a": "...", "ops": "..."}
# NW_RATE_LIMIT_RPS=10             # token bucket per key id (per client address without a key); 0 turns it off
# NW_RATE_LIMIT_BURST=30           # tokens a key can spend at once; beyond it 429 with Retry-After

# Tracing: OTLP to the local collector, or the track's native trace store.
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
# NW_TRACE_EXPORT=xray | cloudtrace

# Project 1: triage
# NW_TRIAGE_MODEL=artifacts/triage/latest
# NW_TRIAGE_SHADOW_MODEL=        # a second artifact scored on every request, never served
# NW_TRIAGE_CAPTURE=artifacts/triage/predictions.jsonl   # requests and predictions for backtests
# NW_TRIAGE_DRIFT_WINDOW=500     # requests in the drift window; NW_TRIAGE_DRIFT_MIN=50; NW_TRIAGE_DRIFT_EVERY=50
# NW_MLFLOW_URI=sqlite:///artifacts/mlflow.db

# Project 2: semantic engine
# NW_SEMANTIC_ARTIFACT=artifacts/semantic/latest   # a version, latest, a flat directory, or the root (means latest)
# NW_SEMANTIC_SHADOW_ARTIFACT=   # a second artifact, same shapes of path, scored on every request, never served
# NW_SEMANTIC_CAPTURE=artifacts/semantic/predictions.jsonl   # requests and predictions for backtests
# NW_SEMANTIC_DRIFT_WINDOW=500   # requests in the drift window; NW_SEMANTIC_DRIFT_MIN=50; NW_SEMANTIC_DRIFT_EVERY=50
# NW_INDEX=artifacts/index
# NW_QUANTIZED=1

# Project 3: policy service
# NW_POLICY_INDEX=artifacts/policy
# NW_POLICY_MIN_SCORE=0.0      # refusal bar on the 0 to 1 confidence scale
# NW_POLICY_RERANK=1
# NW_POLICY_CORPUS=data/policies                       # compared with the index manifest at startup; nw_policy_index_stale
# NW_POLICY_CACHE_TTL_S=0                              # exact-match response cache; 0 is off. NW_POLICY_CACHE_SIZE=1000
# NW_POLICY_FEEDBACK=artifacts/policy/feedback.jsonl   # verdicts from POST /feedback with the answer's question, citations and prompt version
# NW_POLICY_CAPTURE=artifacts/policy/capture.jsonl     # every /ask: question, citations, confidence, refused, prompt version, cached
# NW_POLICY_DRIFT_WINDOW=500     # requests in the drift window; NW_POLICY_DRIFT_MIN=50; NW_POLICY_DRIFT_EVERY=50

# Project 4: agents
# NW_TOOL_BACKEND=local | http
# NW_AGENT_ROLE=resolver | triage | policy | resolution | orchestrator
# NW_TRIAGE_URL=http://localhost:8001
# NW_SEMANTIC_URL=http://localhost:8002
# NW_POLICY_URL=http://localhost:8003
# NW_TRIAGE_AGENT_URL=http://localhost:8011
# NW_POLICY_AGENT_URL=http://localhost:8012
# NW_RESOLUTION_AGENT_URL=http://localhost:8013
# NW_ESCALATION_QUEUE=artifacts/escalations.jsonl
# NW_ESCALATION_DEDUPE_S=3600     # the same ticket is not escalated twice inside the window; 0 turns it off
# NW_AGENT_MAX_TOTAL_TOKENS=      # token budget per resolver run (input plus output); stops with budget
# NW_TRACE_DIR=artifacts/traces
# NW_AGENT_DISABLED=1            # kill switch: /run and /route answer 503, readiness unchanged
# NW_AGENT_MAX_CONCURRENT_RUNS=4  # runs in flight beyond it get 429 before any model call
# NW_AGENT_CAPTURE=artifacts/agent_runs.jsonl   # one JSON line per run for drift backtests
# NW_AGENT_BASELINE=data/golden/agent_baseline.json   # the drift monitor's and the gate's reference
# NW_AGENT_DRIFT_WINDOW=200      # runs in the drift window; NW_AGENT_DRIFT_MIN=20

# MCP server
# NW_MCP_TRANSPORT=streamable-http | stdio
# NW_MCP_HOST=127.0.0.1
# NW_MCP_PORT=8020
# NW_MCP_ALLOWED_HOSTS=localhost:*,127.0.0.1:*

# Screening in front of the agent and /ask (set by the platform deploy)
# NW_GUARDRAIL_ID=              # Bedrock Guardrails; also screens /ask on the policy service
# NW_GUARDRAIL_VERSION=DRAFT
# NW_MODEL_ARMOR_TEMPLATE=      # projects/<p>/locations/<l>/templates/<t>

# Local track platform (deploy/local/README.md)
# NW_GATEWAY_URL=http://localhost:4000        # the LiteLLM gateway from the laptop; containers use litellm:4000
# NW_GATEWAY_KEY=sk-nw-solo-change-me         # your line in deploy/local/litellm/tenants.tsv
# NW_MLFLOW_URI=http://localhost:5001         # the stack's MLflow instead of the sqlite file
# NW_QDRANT_URL=http://localhost:6333
# NW_ENDPOINT_URL=http://localhost:8005       # the serving proxy (higher environment: 8105)
# NW_AGENT_RUNTIME_URL=http://localhost:8014
# NW_PIPELINE_ROOT=artifacts/pipelines
# NW_KFP_RUNNER=subprocess                    # or docker
# NW_REGISTRY=localhost:5050
# NW_IMAGE_TAG=dev
# LITELLM_MASTER_KEY=sk-nw-master-change-me
# ANTHROPIC_API_KEY=                          # set it and the gateway serves claude-opus-5 and judge from Claude
# NW_COMPOSE_OLLAMA_INTERNAL_URL=http://ollama:11434   # http://host.docker.internal:11434 for a native Ollama (Mac)
# NW_OLLAMA_MODELS_DIR=ollama-models          # or ~/.ollama to share the host's model store
# NW_OLLAMA_PULL="llama-guard3:1b gpt-oss:20b"
# NW_S3_ACCESS_KEY=nw
# NW_S3_SECRET_KEY=northwind-secret
# NW_DB_PASSWORD=northwind
# NW_GRAFANA_PASSWORD=northwind
# NW_AGENT_IMAGE=                  # the agent image platform.agents.deploy uses: AgentImage output (AWS), the images-gcp tag (Google), localhost:5050/nw-agent:dev (Local)

# Azure track (ADR 0013); deploy/azure/outputs.json fills these after make deploy-azure
# NW_AZURE_SUBSCRIPTION_ID=
# NW_AZURE_RESOURCE_GROUP=
# NW_AZURE_LOCATION=eastus2
# NW_AZURE_ML_WORKSPACE=
# NW_AZURE_FOUNDRY_ENDPOINT=         # https://<resource>.services.ai.azure.com
# NW_AZURE_FOUNDRY_PROJECT=
# NW_AZURE_FOUNDRY_KEY=              # unset means Entra ID (az login, managed identity in the cloud)
# NW_AZURE_SEARCH_ENDPOINT=
# NW_AZURE_SEARCH_INDEX=             # the policy service's index when NW_RETRIEVER=ai-search
# NW_AZURE_KEY_VAULT=
# NW_AZURE_ACR=
# NW_AZURE_STORAGE_ACCOUNT=
# NW_AZURE_APPINSIGHTS_CONNECTION_STRING=   # set on the azure track: traces go to Application Insights
# NW_AZURE_APIM_GATEWAY_URL=         # the model gateway (API Management); unset, read from outputs.json; empty, no APIM
#                                    # NW_GATEWAY_KEY is the tenant's APIM subscription key; NW_GATEWAY_URL stays unset (it means LiteLLM)
# NW_AZURE_CONTENT_SAFETY_ENDPOINT=  # Prompt Shields in front of the agent and /ask: https://<foundry>.cognitiveservices.azure.com
# NW_AZURE_CONTENT_SAFETY_KEY=       # unset means Entra ID (Cognitive Services User on the Foundry resource)
# NW_AZURE_OUTPUTS=                  # another outputs.json; empty ignores the file
# NW_AZURE_CONTAINERAPPS_ENV=
# NW_AZURE_RAI_POLICY=               # Foundry content safety policy the hosted agent's guardrail uses
# NW_AZURE_PIPELINE_IDENTITY_CLIENT_ID=
