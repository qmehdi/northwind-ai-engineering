    {
     "refId": "B",
     "expr": "sum by (result) (rate(nw_policy_cache_total[5m]))",
     "legendFormat": "cache {{result}}"
    },
    {
     "refId": "C",
     "expr": "nw_policy_index_stale",
     "legendFormat": "index stale"
    }
   ]
  },
  {
   "id": 11,
   "type": "timeseries",
   "title": "Tokens and spend",
   "datasource": {
    "type": "prometheus",
